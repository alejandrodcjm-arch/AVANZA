# Copie este archivo a .env.local y llene los valores. Nunca suba .env.local a GitHub.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
# Solo servidor. Se usa para crear cuentas de maestros y para las tareas programadas.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# URL pública de la app (sin diagonal al final)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secreto compartido con Supabase Cron (Vault: cron_secret). Genere uno con: openssl rand -hex 32
CRON_SECRET=

# Claude API (console.anthropic.com). Sin llave, los resúmenes quedan para redacción manual.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Correo (resend.com). Sin llave, los correos se imprimen en la consola (solo desarrollo).
RESEND_API_KEY=
EMAIL_FROM="Avanza <avisos@tudominio.mx>"

# Notificaciones push (genere con: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@tudominio.mx
